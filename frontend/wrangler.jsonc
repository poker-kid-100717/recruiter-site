{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joshua-davis-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "portfolio-joshdavis.app",
      "custom_domain": true
    },
    {
      "pattern": "www.portfolio-joshdavis.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/portfolio/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/health",
      "/healthz"
    ]
  }
}
