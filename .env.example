# Local Docker Compose only. Production uses the WORKER_DATABASE_URL GitHub secret (Neon).
POSTGRES_PASSWORD=portfolio-local

# For running db/*.mjs, the .NET API, or `wrangler dev` against a local Postgres
# (wrangler dev reads frontend/.dev.vars; copy this line there).
DATABASE_URL=postgres://portfolio:portfolio-local@127.0.0.1:5432/portfolio
